# =============================================================================
# CARDEX VPS — environment template.  cp .env.template .env  then fill the blanks.
# NEVER commit a populated .env.
# =============================================================================

# ── Secrets (CHANGE THESE) ───────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_postgres
REDIS_PASSWORD=change_me_redis

# ── Entity API exposure ──────────────────────────────────────────────────────
# Bind to 127.0.0.1 and reach it over an SSH tunnel, OR 0.0.0.0 behind the VPS
# firewall / a reverse proxy. Port Elias opens:  http://<bind>:<port>/v1/health
ENTITY_API_BIND=127.0.0.1
ENTITY_API_PORT=8088

# ── RESIDENTIAL PROXY SLOTS ───────────────────────────────────────────────────
# Fill a country's slot to unblock its T2/T3 (DEFENDED) portals. When set, the
# identity bootstrap provisions a RESIDENTIAL_ROTATING, premium-trust identity for
# that country and the coordinator picks it automatically for the giants — no code
# change. Format:  http://USER:PASS@HOST:PORT   (or socks5://…). Leave blank to keep
# that country's defended portals parked on NO_IDENTITY.
#
# The 4 currently-blocked T1 giants and the slot that unblocks each:
#   lacentrale.fr      (DataDome)  → RESIDENTIAL_PROXY_FR
#   promoneuve.fr      (DataDome)  → RESIDENTIAL_PROXY_FR
#   milanuncios.com    (DataDome)  → RESIDENTIAL_PROXY_ES
#   nederlandmobiel.nl (Cloudflare)→ RESIDENTIAL_PROXY_NL
# (mobile.de/kleinanzeigen Akamai → RESIDENTIAL_PROXY_DE; coches.net → _ES; etc.)
RESIDENTIAL_PROXY_DE=
RESIDENTIAL_PROXY_FR=
RESIDENTIAL_PROXY_ES=
RESIDENTIAL_PROXY_NL=
RESIDENTIAL_PROXY_BE=
RESIDENTIAL_PROXY_CH=

# ── FX (CH listings persist NULL EUR without it; override with today's ECB rate)─
FX_RATE_CHF=1.05

# ── Tuning (defaults are VPS-sane; raise on bigger boxes) ─────────────────────
LOG_LEVEL=info
CYCLE_WAIT_SECONDS=3600          # seconds between full harvest cycles per portal
SCRAPER_MEM=1500M                # per-coordinator container memory cap (Camoufox)
ENRICH_CONCURRENCY=10            # A6 enrich_worker concurrency
DISCOVERY_COUNTRIES=DE,FR,ES,NL,BE,CH

# Postgres / Redis memory (size to the VPS — see SIZING.md)
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE=3GB
REDIS_MAXMEMORY=2gb
