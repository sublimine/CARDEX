# Dockerfile.discovery — CARDEX Discovery Service
# Multi-stage build: Go 1.26.2 builder → distroless/static runtime
# Result: ~15 MB statically-linked binary in a minimal, non-root container.
#
# Build context is the repo root (see docker-compose.yml: context ../..).
# Health probe: /healthz is served on the metrics port (:9101), NOT :8080.
# distroless/static has no shell/wget, so a tiny static probe binary is baked in.

# ── Stage 1: build ───────────────────────────────────────────────
FROM golang:1.26.2-bookworm AS builder

ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOWORK=off

WORKDIR /src

# Copy module files first for layer cache
COPY go.work go.work.sum ./
COPY discovery/go.mod discovery/go.sum ./discovery/

# Download dependencies (cached unless go.mod changes)
WORKDIR /src/discovery
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy source
WORKDIR /src
COPY discovery/ ./discovery/
COPY internal/ ./internal/

# Build statically linked service binary
WORKDIR /src/discovery
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build \
    -ldflags="-s -w -extldflags=-static" \
    -trimpath \
    -o /out/cardex-discovery \
    ./cmd/discovery-service/

# Build the distroless-compatible health probe (stdlib only, no deps)
COPY deploy/docker/healthcheck/ /src/healthcheck/
WORKDIR /src/healthcheck
RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -ldflags="-s -w" -trimpath -o /out/healthcheck .

# ── Stage 2: runtime ─────────────────────────────────────────────
# Pin digest in production to prevent supply-chain substitution:
# docker pull gcr.io/distroless/static-debian12:nonroot && docker inspect --format='{{index .RepoDigests 0}}'
# Then replace :nonroot with :nonroot@sha256:<digest>
FROM gcr.io/distroless/static-debian12:nonroot

ARG VERSION=dev
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="cardex-discovery" \
      org.opencontainers.image.description="CARDEX Discovery Service — familias A-O" \
      org.opencontainers.image.source="https://github.com/cardex/cardex" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="UNLICENSED"

# Non-root user already provided by distroless/static:nonroot (uid=65532);
# declared explicitly here as defense-in-depth.
USER 65532:65532

COPY --from=builder /out/cardex-discovery /cardex-discovery
COPY --from=builder /out/healthcheck /healthcheck

# Health + metrics ports. /healthz + /metrics are served on the metrics port.
EXPOSE 9101

# /healthz lives on the metrics port (DISCOVERY_METRICS_ADDR, default :9101).
ENV HEALTHCHECK_URL=http://127.0.0.1:9101/healthz

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["/healthcheck"]

ENTRYPOINT ["/cardex-discovery"]
