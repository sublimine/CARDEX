# Dockerfile.extraction — CARDEX Extraction Service
# Multi-stage build: Go 1.26.2 builder → distroless/static runtime
# Note: Playwright/Chromium strategies (E07) require a non-distroless image when enabled.
# Set BUILD_TAGS=playwright to include Chromium; default is headless-only.
#
# Build context is the repo root (see docker-compose.yml: context ../..).
# Health probe: /health is served on the metrics port (:9102), NOT :8080.

# ── Stage 1: build ───────────────────────────────────────────────
FROM golang:1.26.2-bookworm AS builder

ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOWORK=off

WORKDIR /src

COPY go.work go.work.sum ./
COPY extraction/go.mod extraction/go.sum ./extraction/

WORKDIR /src/extraction
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

WORKDIR /src
COPY extraction/ ./extraction/
COPY internal/ ./internal/

WORKDIR /src/extraction
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build \
    -ldflags="-s -w -extldflags=-static" \
    -trimpath \
    -o /out/cardex-extraction \
    ./cmd/extraction-service/

# Build the distroless-compatible health probe (stdlib only, no deps)
COPY deploy/docker/healthcheck/ /src/healthcheck/
WORKDIR /src/healthcheck
RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -ldflags="-s -w" -trimpath -o /out/healthcheck .

# ── Stage 2: runtime ─────────────────────────────────────────────
# Pin digest in production to prevent supply-chain substitution:
# docker pull gcr.io/distroless/static-debian12:nonroot && docker inspect --format='{{index .RepoDigests 0}}'
# Then replace :nonroot with :nonroot@sha256:<digest>
FROM gcr.io/distroless/static-debian12:nonroot

ARG VERSION=dev
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="cardex-extraction" \
      org.opencontainers.image.description="CARDEX Extraction Service — E01-E12" \
      org.opencontainers.image.source="https://github.com/cardex/cardex" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="UNLICENSED"

USER 65532:65532

COPY --from=builder /out/cardex-extraction /cardex-extraction
COPY --from=builder /out/healthcheck /healthcheck

# /health + /metrics are served on the metrics port.
EXPOSE 9102

# /health lives on the metrics port (EXTRACTION_METRICS_ADDR, compose sets :9102).
ENV HEALTHCHECK_URL=http://127.0.0.1:9102/health

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["/healthcheck"]

ENTRYPOINT ["/cardex-extraction"]
