{
  "source_key": "autotrack.nl",
  "country": "NL",
  "strategy": "portal_paginated",
  "version": 1,
  "endpoints": {
    "host": "www.autotrack.nl",
    "listing_url_template": "https://www.autotrack.nl/aanbod?pageNumber={page}",
    "detail_url_re": "href=\"(/a/[a-z0-9\\-]+-(\\d+))\\?from_srp=true\"",
    "sitemap_url": "",
    "api_url": ""
  },
  "pagination": {
    "page_size": 30,
    "max_pages": 7500,
    "page_param": "pageNumber"
  },
  "extraction": {
    "method": "jsonld",
    "field_map": {
      "make": "brand.name",
      "model": "model",
      "year": "vehicleModelDate",
      "price": "offers.price",
      "currency": "offers.priceCurrency",
      "mileage_km": "mileageFromOdometer.value",
      "fuel_type": "fuelType",
      "transmission": "vehicleTransmission",
      "vin": "vehicleIdentificationNumber",
      "images": "image"
    }
  },
  "drift_baseline": {
    "extraction_method": "jsonld",
    "expected_min_volume": 1000,
    "required_fields": ["make", "model", "year", "price", "images"],
    "min_nonnull_ratio": 0.7
  }
}
