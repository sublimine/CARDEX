  "leaf_cap": 2000,
  "extraction": {
    "method": "ssr_state",
    "state_var": "window.__INITIAL_STATE__",
    "listing_path": "search.srp.data.searchResults.items",
    "url_base": "https://suchen.mobile.de",
    "field_map": {
      "id": "id", "make": "make", "model": "model",
      "price": "price.grossAmount", "url": "relativeUrl"
    }
  },
