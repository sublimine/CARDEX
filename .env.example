# =============================================================================
# CARDEX — Environment Variables Reference
# Copy to .env and fill in. NEVER commit the actual .env.
# Catalog rebuilt 2026-06-12 from the variables the code actually reads
# (scrapers/, services/entity_api, services/api, dashboard/, discovery/).
# =============================================================================

# -----------------------------------------------------------------------------
# Core infrastructure (LIVE — Python fleet + entity_api)
# -----------------------------------------------------------------------------
# Dev Docker stack defaults to user 'cardex' / password 'cardex_dev_only'
# (public knowledge — override in ANY deployment; see SECURITY.md).
DATABASE_URL=postgresql://cardex:cardex_dev_only@localhost:5432/cardex
REDIS_URL=redis://:cardex_dev_only@localhost:6379
POSTGRES_PASSWORD=cardex_dev_only
REDIS_PASSWORD=cardex_dev_only
LOG_LEVEL=info

# Fleet engine state (SQLite by design — do not point at PG)
ENGINE_DB_PATH=scrapers/engine.db

# -----------------------------------------------------------------------------
# Ollama fuzzy-decision layer (LIVE, fail-open)
# -----------------------------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# -----------------------------------------------------------------------------
# Price-intelligence API (services/api, Go)
# -----------------------------------------------------------------------------
API_BOOTSTRAP_KEY=
ALERTS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@cardex.eu

# -----------------------------------------------------------------------------
# MeiliSearch mirror (optional; scrapers/discovery/meili_bridge.py)
# -----------------------------------------------------------------------------
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=

# -----------------------------------------------------------------------------
# Registry connectors (live Python discovery)
# -----------------------------------------------------------------------------
# Swiss commercial registry (Zefix)
ZEFIX_USER=
ZEFIX_PASS=

# -----------------------------------------------------------------------------
# Fleet tuning (defaults live in code; set only to override)
# -----------------------------------------------------------------------------
# OSM_COUNTRIES=ES,FR,DE,NL,BE,CH
# DOMRES_VALIDATE_TOP= / DOMRES_RSS_LIMIT_MB= / DOMRES_MAX_ATTEMPTS=
# WP_HARVESTER_CONC= / WP_HARVESTER_PER_PAGE= / WP_HARVESTER_TIMEOUT=
# SITEMAP_RESOLVER_CONCURRENCY= / SITEMAP_RESOLVER_BATCH= / SITEMAP_IMG_TIMEOUT=
# THROWAWAY_REDIS_URL=   (validation-only flows; never the production Redis)

# -----------------------------------------------------------------------------
# Dashboard (local control panel)
# -----------------------------------------------------------------------------
CARDEX_PG_DB=cardex
CARDEX_PG_USER=cardex
CARDEX_REDIS_PASSWORD=cardex_dev_only

# -----------------------------------------------------------------------------
# DORMANT Go discovery scaffold — external source API keys
# (only needed if running the Go discovery families)
# -----------------------------------------------------------------------------
INSEE_TOKEN=
KVK_API_KEY=
KBO_USER=
KBO_PASS=
PAPPERS_API_KEY=
SHODAN_API_KEY=
VIEWDNS_API_KEY=
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# Removed from this catalog (the code no longer reads them):
#   CLICKHOUSE_* (OLAP layer not in the live path), JWT_RS256_* / JWT_DEV_SECRET,
#   GOOGLE_MAPS_API_KEY, QUOTE_SECRET (alpha engine purged), NEXT_PUBLIC_*
#   (no Next.js app in this repo), SPIDER_CONCURRENCY / DISCOVERY_PLAYWRIGHT_MAX
#   (not read by any current module).
# CAPTCHA-solver and proxy-vendor credentials are gated behind a literal owner
# spending decision (Strategy B) and are not configured here.
# =============================================================================
